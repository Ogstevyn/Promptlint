# Mozilla Otari LLM Gateway Configuration
OTARI_BASE_URL=https://eu.api.otari.ai/api/v1
OTARI_API_KEY=otk_v1_eu_your_api_key_here

# Default optimizer model routed through Otari
OTARI_OPTIMIZER_MODEL=alibaba/qwen-3.5-35b-a3b
# Reasoning effort for the optimizer call: none (default), low, medium, high,
# or "omit" for models that reject the parameter
OTARI_OPTIMIZER_REASONING_EFFORT=none

# Benchmark model pair (must be ids from GET /api/v1/models on your gateway)
OTARI_BENCHMARK_ORIGINAL_MODEL=mistralai/mistral-large-latest
OTARI_BENCHMARK_OPTIMIZED_MODEL=mistralai/ministral-8b-latest

# Any model id above may be an Otari routing policy name instead (e.g. a Fallback
# policy "promptlint-cheap"); PromptLint reports Otari-Fallback and the served model.
# Model attacked in the Injection Arena (defaults to the benchmark's original model)
OTARI_ARENA_MODEL=

# Otari guardrail sent with every optimize, benchmark and arena call:
# off, monitor (default: verdict in the Otari-Guardrails header) or block
# (Otari refuses flagged input with 403 guardrail_violation)
# Reasoning effort for the models under test (benchmark + Arena): "none" stops
# thinking models such as Qwen 3.5 spending max_tokens on reasoning; "off" omits it
OTARI_TARGET_REASONING_EFFORT=none
OTARI_GUARDRAIL_MODE=monitor
OTARI_GUARDRAIL_PROFILE=prompt-injection

# Per-user budgets: set to 1 when OTARI_API_KEY is an Otari *service key*; each
# request then names its end user (web demo user, X-PromptLint-User) as `user`,
# and Otari holds that user to their own budget
OTARI_END_USERS=0

# Set to 1 to force the offline simulator even when OTARI_API_KEY is set
PROMPTLINT_OFFLINE=0

# PromptLint Backend API Server Configuration
PORT=4000
CORS_ORIGIN=*

# GitHub CI Integration (Automatically populated in GitHub Actions)
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_PR_NUMBER=
