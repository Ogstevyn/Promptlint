# Mozilla Otari LLM Gateway Configuration
OTARI_BASE_URL=https://eu.api.otari.ai/api/v1
OTARI_API_KEY=otk_v1_eu_your_api_key_here

# Default optimizer model routed through Otari
OTARI_OPTIMIZER_MODEL=alibaba/qwen-3.5-35b-a3b

# PromptLint Backend API Server Configuration
PORT=4000
CORS_ORIGIN=*

# GitHub CI Integration (Automatically populated in GitHub Actions)
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_PR_NUMBER=
