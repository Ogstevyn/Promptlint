# Mozilla Otari LLM Gateway Configuration
OTARI_BASE_URL=https://eu.api.otari.ai/api/v1
OTARI_API_KEY=otk_v1_eu_your_api_key_here

# Default optimizer model routed through Otari
OTARI_OPTIMIZER_MODEL=alibaba/qwen-3.5-35b-a3b
# Reasoning effort for the optimizer call: none (default), low, medium, high,
# or "omit" for models that reject the parameter
OTARI_OPTIMIZER_REASONING_EFFORT=none

# Benchmark model pair (must be ids from GET /api/v1/models on your gateway)
OTARI_BENCHMARK_ORIGINAL_MODEL=mistralai/mistral-large-latest
OTARI_BENCHMARK_OPTIMIZED_MODEL=mistralai/ministral-8b-latest

# Set to 1 to force the offline simulator even when OTARI_API_KEY is set
PROMPTLINT_OFFLINE=0

# PromptLint Backend API Server Configuration
PORT=4000
CORS_ORIGIN=*

# GitHub CI Integration (Automatically populated in GitHub Actions)
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_PR_NUMBER=
