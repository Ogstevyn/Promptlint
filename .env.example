# Mozilla Otari LLM Gateway Configuration
OTARI_BASE_URL=https://api.otari.ai/api/v1
OTARI_API_KEY=otari_your_api_key_here

# Default optimizer model routed through Otari
OTARI_OPTIMIZER_MODEL=gpt-4o-mini

# PromptLint Backend API Server Configuration
PORT=4000
CORS_ORIGIN=*

# GitHub CI Integration (Automatically populated in GitHub Actions)
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_PR_NUMBER=
